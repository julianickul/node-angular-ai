{
  "name": "@nnaai/shared-types",
  "version": "1.0.0",
  "description": "Shared types, DTOs and interfaces for fullstack demo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "build:watch": "tsc --watch",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "typescript",
    "shared-types",
    "dto",
    "nestjs",
    "angular"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "typescript": "~5.5.0"
  },
  "peerDependencies": {
    "@types/node": "^20.0.0"
  }
}
