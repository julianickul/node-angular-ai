{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../dist/backend",
    "rootDir": ".",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "test/**/*",
    "**/__tests__/**/*"
  ],
  "references": [
    { "path": "../shared-types" }
  ]
}